.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.streamlit/secrets.toml

# Commit the small saved prediction files needed by a fresh cloud checkout.
# Keep other generated files, locks, backups, and machine-specific queues out.
/data/processed/*
!/data/processed/context.json
!/data/processed/mpl_ph_s17_player_games.json
!/data/processed/mpl_ph_s18_player_games.json
!/data/processed/live_snapshot.json
/models/*
!/models/player_elo_model.json
